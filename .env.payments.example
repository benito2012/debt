# ============================================================
# ADD THESE TO YOUR EXISTING .env.example
# ============================================================

# --- STRIPE PAYMENTS (separate from subscription Stripe) ---
# Use same Stripe account, but add a new webhook for payments
STRIPE_PAYMENT_WEBHOOK_SECRET=whsec_your-payment-webhook-secret

# --- M-PESA (Safaricom Daraja API) ---
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379                    # Your Paybill or Till number
MPESA_PASSKEY=your-passkey-from-safaricom
MPESA_INITIATOR_NAME=your-initiator-name  # For B2B payouts
MPESA_SECURITY_CREDENTIAL=your-encrypted-credential

# --- FLUTTERWAVE (Pan-Africa + Global) ---
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-key
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret

# ============================================================
# STRIPE WEBHOOK SETUP
# Add a SECOND webhook endpoint in Stripe dashboard:
# URL: https://yourdomain.com/api/payments/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
# ============================================================

# ============================================================
# M-PESA SETUP — GET THESE FROM SAFARICOM DEVELOPER PORTAL
# 1. Register at developer.safaricom.co.ke
# 2. Create an app → get Consumer Key + Secret
# 3. Apply for Go-Live to get production Paybill
# 4. Whitelist your callback URL:
#    https://yourdomain.com/api/payments/mpesa-webhook
# ============================================================

# ============================================================
# FLUTTERWAVE SETUP
# 1. Register at dashboard.flutterwave.com
# 2. Get API keys from Settings → API
# 3. Set webhook URL: https://yourdomain.com/api/payments/flutterwave-webhook
# 4. Supports: Nigeria, Ghana, Kenya, Uganda, Tanzania, Rwanda,
#    UK, US, Europe and 30+ more countries
# ============================================================
